<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  JMETER END-TO-END LOAD TEST PLAN
  Activity Upload & Extraction API
  ============================================================
  Author  : Performance Engineering Team
  Version : 1.0
  Date    : February 2026

  Test Coverage (13 Endpoints):
    Thread Group 1 — USER E2E WORKFLOW (90% traffic)
      S1  POST /activity/presign
      S2  POST /activity/upload
      S3  POST /extract
      S4  POST /user/quiz-generate
      S5  POST /user/init-recommend
      S6  POST /user/simulation-create
      S7  POST /user/simulation-evaluation
      S8  POST /user/revise-recommend
      S9  POST /user/image/presign
      S10 POST /user/image/upload

    Thread Group 2 — ADMIN E2E WORKFLOW (10% traffic)
      S11 POST /admin/cluster/presign
      S12 POST /admin/cluster/upload
      S13 POST /admin/cluster/extract

    Thread Group 3 — NEGATIVE / BOUNDARY TESTS (background)

  Usage:
    jmeter -n -t jmeter_e2e_load_test.jmx \
           -Jbase_url=https://api.example.com \
           -Jthreads=200 \
           -Jramp_up=300 \
           -Jduration=2700 \
           -l results/results.jtl \
           -e -o results/html-report/

  User-defined variables (override via -J flags):
    base_url     — API base URL            (default: http://localhost:8080)
    api_token    — Bearer token if needed  (default: empty)
    threads      — Peak VU count           (default: 100)
    admin_threads— Admin VU count          (default: 10)
    ramp_up      — Ramp-up seconds         (default: 300)
    duration     — Steady-state seconds    (default: 1800)
    think_min    — Min think time ms       (default: 1000)
    think_max    — Max think time ms       (default: 3000)
  ============================================================
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>

    <!-- ═══════════════════════════════════════════════════
         TEST PLAN ROOT
    ═══════════════════════════════════════════════════════ -->
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan"
              testname="Activity Upload &amp; Extraction API — E2E Load Test"
              enabled="true">
      <stringProp name="TestPlan.comments">
        End-to-End Performance Test covering all 13 API endpoints.
        Run: jmeter -n -t jmeter_e2e_load_test.jmx -Jbase_url=https://api.example.com
      </stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments">
        <collectionProp name="Arguments.arguments">
          <elementProp name="base_url" elementType="Argument">
            <stringProp name="Argument.name">base_url</stringProp>
            <stringProp name="Argument.value">${__P(base_url,http://localhost:8080)}</stringProp>
          </elementProp>
          <elementProp name="api_token" elementType="Argument">
            <stringProp name="Argument.name">api_token</stringProp>
            <stringProp name="Argument.value">${__P(api_token,)}</stringProp>
          </elementProp>
          <elementProp name="threads" elementType="Argument">
            <stringProp name="Argument.name">threads</stringProp>
            <stringProp name="Argument.value">${__P(threads,100)}</stringProp>
          </elementProp>
          <elementProp name="admin_threads" elementType="Argument">
            <stringProp name="Argument.name">admin_threads</stringProp>
            <stringProp name="Argument.value">${__P(admin_threads,10)}</stringProp>
          </elementProp>
          <elementProp name="ramp_up" elementType="Argument">
            <stringProp name="Argument.name">ramp_up</stringProp>
            <stringProp name="Argument.value">${__P(ramp_up,300)}</stringProp>
          </elementProp>
          <elementProp name="duration" elementType="Argument">
            <stringProp name="Argument.name">duration</stringProp>
            <stringProp name="Argument.value">${__P(duration,1800)}</stringProp>
          </elementProp>
          <elementProp name="think_min" elementType="Argument">
            <stringProp name="Argument.name">think_min</stringProp>
            <stringProp name="Argument.value">${__P(think_min,1000)}</stringProp>
          </elementProp>
          <elementProp name="think_max" elementType="Argument">
            <stringProp name="Argument.name">think_max</stringProp>
            <stringProp name="Argument.value">${__P(think_max,3000)}</stringProp>
          </elementProp>
          <!-- Computed unique ID base: VU number offset -->
          <elementProp name="id_offset" elementType="Argument">
            <stringProp name="Argument.name">id_offset</stringProp>
            <stringProp name="Argument.value">100000</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>

      <!-- ═══════════════════════════════════════════════════
           HTTP REQUEST DEFAULTS  (applied to all samplers)
      ═══════════════════════════════════════════════════════ -->
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement"
                         testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
          <collectionProp name="Arguments.arguments"/>
        </elementProp>
        <stringProp name="HTTPSampler.domain">${base_url}</stringProp>
        <stringProp name="HTTPSampler.port"></stringProp>
        <stringProp name="HTTPSampler.protocol"></stringProp>
        <stringProp name="HTTPSampler.connect_timeout">10000</stringProp>
        <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
        <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
      </ConfigTestElement>
      <hashTree/>

      <!-- ═══════════════════════════════════════════════════
           HTTP HEADER MANAGER (global)
      ═══════════════════════════════════════════════════════ -->
      <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                     testname="Global HTTP Headers" enabled="true">
        <collectionProp name="HeaderManager.headers">
          <elementProp name="Accept" elementType="Header">
            <stringProp name="Header.name">Accept</stringProp>
            <stringProp name="Header.value">application/json</stringProp>
          </elementProp>
          <elementProp name="Authorization" elementType="Header">
            <stringProp name="Header.name">Authorization</stringProp>
            <stringProp name="Header.value">Bearer ${api_token}</stringProp>
          </elementProp>
          <elementProp name="X-Test-Run" elementType="Header">
            <stringProp name="Header.name">X-Test-Run</stringProp>
            <stringProp name="Header.value">performance-e2e-${__time(yyyyMMdd)}</stringProp>
          </elementProp>
        </collectionProp>
      </HeaderManager>
      <hashTree/>

      <!-- ═══════════════════════════════════════════════════
           CSV DATA SET — Test User Pool
      ═══════════════════════════════════════════════════════ -->
      <!--
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet"
                  testname="User Test Data" enabled="true">
        <stringProp name="filename">testdata/users.csv</stringProp>
        <stringProp name="variableNames">test_user_id,test_assessment_id,test_cluster_id</stringProp>
        <stringProp name="delimiter">,</stringProp>
        <boolProp name="quotedData">false</boolProp>
        <boolProp name="recycle">true</boolProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
      </CSVDataSet>
      <hashTree/>
      -->

      <!-- ═══════════════════════════════════════════════════
           THREAD GROUP 1 — USER E2E WORKFLOW
      ═══════════════════════════════════════════════════════ -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup"
                   testname="TG1 — User E2E Workflow (90% traffic)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${threads}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${ramp_up}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${duration}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
      </ThreadGroup>
      <hashTree>

        <!-- ── Counter: unique assessment_id per thread+iteration ── -->
        <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig"
                       testname="Assessment ID Counter" enabled="true">
          <stringProp name="CounterConfig.start">100001</stringProp>
          <stringProp name="CounterConfig.end">9999999</stringProp>
          <stringProp name="CounterConfig.incr">1</stringProp>
          <stringProp name="CounterConfig.name">assessment_id</stringProp>
          <stringProp name="CounterConfig.format"></stringProp>
          <boolProp name="CounterConfig.per_user">true</boolProp>
        </CounterConfig>
        <hashTree/>

        <!-- ── Random file name variable ── -->
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor"
                            testname="Set Random Variables" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">
import java.util.Random
Random rand = new Random()

// Random file selection
def pdfFiles = ['resume.pdf', 'cv.pdf', 'portfolio.pdf', 'experience.pdf']
def docxFiles = ['skills.docx', 'history.docx']
def allActivity = pdfFiles + docxFiles
def imageFiles = ['profile_pic.jpg', 'avatar.jpeg', 'headshot.png']
def reasons = ['User requested alternative', 'Low simulation score', 'New skill data', 'Preference update']

vars.put('activity_file_name', allActivity[rand.nextInt(allActivity.size())])
vars.put('image_file_name', imageFiles[rand.nextInt(imageFiles.size())])
vars.put('revise_reason', reasons[rand.nextInt(reasons.size())])
vars.put('cluster_id', String.valueOf(rand.nextInt(900) + 100))
vars.put('think_time', String.valueOf(rand.nextInt(
  Integer.parseInt(vars.get('think_max')) - Integer.parseInt(vars.get('think_min'))
) + Integer.parseInt(vars.get('think_min'))))
vars.put('run_image_upload', (rand.nextInt(3) == 0) ? 'true' : 'false')
          </stringProp>
        </JSR223PreProcessor>
        <hashTree/>

        <!-- ╔══════════════════════════════════════════╗ -->
        <!-- ║  STAGE 1: ACTIVITY PRESIGN               ║ -->
        <!-- ╚══════════════════════════════════════════╝ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="S1 — Activity Presign" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="POST /activity/presign" enabled="true">
            <stringProp name="HTTPSampler.path">/activity/presign</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <stringProp name="Argument.value">{"file_name": "${activity_file_name}"}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                           testname="Content-Type JSON" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>

            <!-- Extract upload_url and object_key for upload step -->
            <JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor"
                               testname="Extract upload_url" enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">upload_url</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExpr">$.upload_url</stringProp>
              <stringProp name="JSONPathExtractor.defaultValue">PRESIGN_FAILED</stringProp>
            </JSONPathExtractor>
            <hashTree/>
            <JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor"
                               testname="Extract object_key" enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">object_key</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExpr">$.object_key</stringProp>
              <stringProp name="JSONPathExtractor.defaultValue">OBJECT_KEY_FAILED</stringProp>
            </JSONPathExtractor>
            <hashTree/>

            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert 200 OK" enabled="true">
              <collectionProp name="Assertion.test_strings">
                <stringProp name="0">200</stringProp>
              </collectionProp>
              <intProp name="Assertion.test_type">8</intProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            </ResponseAssertion>
            <hashTree/>
            <JSONPathAssertion guiclass="JSONPathAssertionGui" testclass="JSONPathAssertion"
                               testname="Assert upload_url present" enabled="true">
              <stringProp name="JSON_PATH">$.upload_url</stringProp>
              <stringProp name="EXPECTED_VALUE"></stringProp>
              <boolProp name="JSONVALIDATION">false</boolProp>
              <boolProp name="EXPECT_NULL">false</boolProp>
            </JSONPathAssertion>
            <hashTree/>

            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                               testname="Response Time &lt; 300ms" enabled="true">
              <longProp name="DurationAssertion.duration">300</longProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree><!-- /presign hashTree -->

          <!-- Think time after presign -->
          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer"
                               testname="Think Time 1-2s" enabled="true">
            <stringProp name="ConstantTimer.delay">1500</stringProp>
            <stringProp name="RandomTimer.range">500</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree><!-- /S1 presign transaction -->

        <!-- ╔══════════════════════════════════════════╗ -->
        <!-- ║  STAGE 2: ACTIVITY FILE UPLOAD           ║ -->
        <!-- ╚══════════════════════════════════════════╝ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="S2 — Activity Upload" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController"
                        testname="Only if presign succeeded" enabled="true">
            <stringProp name="IfController.condition">"${upload_url}" != "PRESIGN_FAILED"</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                              testname="POST /activity/upload" enabled="true">
              <stringProp name="HTTPSampler.path">/activity/upload</stringProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.DO_MULTIPART_POST">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="upload_url" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">upload_url</stringProp>
                    <stringProp name="Argument.value">${upload_url}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                  <elementProp name="object_key" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">object_key</stringProp>
                    <stringProp name="Argument.value">${object_key}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                  <!-- File parameter: points to testdata directory -->
                  <elementProp name="file" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.name">file</stringProp>
                    <stringProp name="Argument.value">testdata/resume_sample.pdf</stringProp>
                    <stringProp name="Argument.contentType">application/pdf</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
              <stringProp name="HTTPSampler.FILES_PARAMS">
                testdata/resume_sample.pdf|file|application/pdf
              </stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                                 testname="Assert 200 OK" enabled="true">
                <collectionProp name="Assertion.test_strings">
                  <stringProp name="0">200</stringProp>
                </collectionProp>
                <intProp name="Assertion.test_type">8</intProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
              </ResponseAssertion>
              <hashTree/>
              <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                                 testname="Response Time &lt; 800ms" enabled="true">
                <longProp name="DurationAssertion.duration">800</longProp>
              </DurationAssertion>
              <hashTree/>
            </hashTree>
          </hashTree>

          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer"
                               testname="Think Time 1-2s" enabled="true">
            <stringProp name="ConstantTimer.delay">1500</stringProp>
            <stringProp name="RandomTimer.range">500</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree><!-- /S2 upload transaction -->

        <!-- ╔══════════════════════════════════════════╗ -->
        <!-- ║  STAGE 3: AI EXTRACTION QUEUE            ║ -->
        <!-- ╚══════════════════════════════════════════╝ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="S3 — AI Extraction" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="POST /extract" enabled="true">
            <stringProp name="HTTPSampler.path">/extract</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <stringProp name="Argument.value">{"assessment_id": ${assessment_id}, "object_key": "${object_key}"}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                           testname="Content-Type JSON" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert 200 OK" enabled="true">
              <collectionProp name="Assertion.test_strings">
                <stringProp name="0">200</stringProp>
              </collectionProp>
              <intProp name="Assertion.test_type">8</intProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            </ResponseAssertion>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert queued in body" enabled="true">
              <collectionProp name="Assertion.test_strings">
                <stringProp name="0">queue</stringProp>
              </collectionProp>
              <intProp name="Assertion.test_type">2</intProp><!-- CONTAINS -->
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                               testname="Response Time &lt; 500ms" enabled="true">
              <longProp name="DurationAssertion.duration">500</longProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>

          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer"
                               testname="Think Time 1-3s" enabled="true">
            <stringProp name="ConstantTimer.delay">2000</stringProp>
            <stringProp name="RandomTimer.range">1000</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree><!-- /S3 extract transaction -->

        <!-- ╔══════════════════════════════════════════╗ -->
        <!-- ║  STAGE 4: QUIZ GENERATE                  ║ -->
        <!-- ╚══════════════════════════════════════════╝ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="S4 — Quiz Generate" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="POST /user/quiz-generate" enabled="true">
            <stringProp name="HTTPSampler.path">/user/quiz-generate</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <stringProp name="Argument.value">{"assessment_id": ${assessment_id}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                           testname="Content-Type JSON" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSONPathExtractor guiclass="JSONPathExtractorGui" testclass="JSONPathExtractor"
                               testname="Extract quiz_id" enabled="true">
              <stringProp name="JSONPathExtractor.referenceName">quiz_id</stringProp>
              <stringProp name="JSONPathExtractor.jsonPathExpr">$.quiz_id</stringProp>
              <stringProp name="JSONPathExtractor.defaultValue">0</stringProp>
            </JSONPathExtractor>
            <hashTree/>
            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion"
                               testname="Assert 200 OK" enabled="true">
              <collectionProp name="Assertion.test_strings">
                <stringProp name="0">200</stringProp>
              </collectionProp>
              <intProp name="Assertion.test_type">8</intProp>
              <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            </ResponseAssertion>
            <hashTree/>
            <DurationAssertion guiclass="DurationAssertionGui" testclass="DurationAssertion"
                               testname="Response Time &lt; 500ms" enabled="true">
              <longProp name="DurationAssertion.duration">500</longProp>
            </DurationAssertion>
            <hashTree/>
          </hashTree>

          <GaussianRandomTimer guiclass="GaussianRandomTimerGui" testclass="GaussianRandomTimer"
                               testname="Think Time" enabled="true">
            <stringProp name="ConstantTimer.delay">1500</stringProp>
            <stringProp name="RandomTimer.range">500</stringProp>
          </GaussianRandomTimer>
          <hashTree/>
        </hashTree><!-- /S4 quiz transaction -->

        <!-- ╔══════════════════════════════════════════╗ -->
        <!-- ║  STAGE 5: INIT RECOMMEND                 ║ -->
        <!-- ╚══════════════════════════════════════════╝ -->
        <TransactionController guiclass="TransactionControllerGui"
                               testclass="TransactionController"
                               testname="S5 — Init Recommend" enabled="true">
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy"
                            testname="POST /user/init-recommend" enabled="true">
            <stringProp name="HTTPSampler.path">/user/init-recommend</stringProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <stringProp name="Argument.value">{"assessment_id": ${assessment_id}}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager"
                           testname="Content-Type JSON" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
